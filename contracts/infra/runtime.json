{
  "version": "0.3-draft",
  "status": "unfrozen",
  "serviceName": "knode-gateway",
  "health": "/actuator/health",
  "liveness": "/actuator/health/liveness",
  "readiness": "auth public-key configuration and authoritative Redis GET available, and enabled governance rules healthy",
  "nacos": {
    "defaultEnabled": false,
    "environment": [
      "NACOS_DISCOVERY_ENABLED",
      "NACOS_CONFIG_ENABLED",
      "NACOS_SERVER_ADDR",
      "NACOS_NAMESPACE",
      "NACOS_CONFIG_IMPORT",
      "NACOS_GROUP",
      "NACOS_USERNAME",
      "NACOS_PASSWORD"
    ]
  },
  "auth": "Shared SDK v0.2 plus nonblocking authoritative session GET; no positive cache",
  "governanceEnvironment": [
    "KNODE_GOV_NACOS_ENABLED",
    "KNODE_GOV_NACOS_SERVER_ADDR",
    "KNODE_GOV_NACOS_NAMESPACE",
    "KNODE_GOV_NACOS_GROUP",
    "KNODE_GOV_NACOS_USERNAME",
    "KNODE_GOV_NACOS_PASSWORD"
  ],
  "authEnvironment": [
    "KNODE_GATEWAY_AUTH_CONFIGURED",
    "KNODE_GATEWAY_AUTH_PUBLIC_KEYS",
    "KNODE_GATEWAY_AUTH_ENVIRONMENT",
    "KNODE_GATEWAY_AUTH_REDIS_HOST",
    "KNODE_GATEWAY_AUTH_REDIS_PORT",
    "KNODE_GATEWAY_AUTH_REDIS_USERNAME",
    "KNODE_GATEWAY_AUTH_REDIS_PASSWORD",
    "KNODE_GATEWAY_AUTH_REDIS_DATABASE",
    "KNODE_GATEWAY_AUTH_TIMEOUT_MS"
  ]
