      "NACOS_NAMESPACE",
      "NACOS_CONFIG_IMPORT",
      "NACOS_GROUP",
      "NACOS_USERNAME",
      "NACOS_PASSWORD"
    ]
  },
  "auth": "unavailable",
  "governanceEnvironment": [
    "KNODE_GOV_NACOS_ENABLED",
    "KNODE_GOV_NACOS_SERVER_ADDR",
    "KNODE_GOV_NACOS_NAMESPACE",
    "KNODE_GOV_NACOS_GROUP",
    "KNODE_GOV_NACOS_USERNAME",
    "KNODE_GOV_NACOS_PASSWORD"
  ]
}
