{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knode:user:delegation-proof:v1",
  "title": "Delegation authority proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proofRef",
    "authority",
    "proofKind",
    "status",
    "subject",
    "actorService",
    "resource",
    "permissionsByAudience",
    "sourceRevision",
    "validUntil",
    "authorizationExpiresAt",
    "parentGrantId",
    "rootGrantId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "proofRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "authority": {
      "enum": [
        "knode-knowledge",
        "knode-agent"
      ]
    },
    "proofKind": {
      "enum": [
        "KNOWLEDGE_CREATE",
        "KNOWLEDGE_CONTINUE",
        "KNOWLEDGE_EXECUTE",
        "KNOWLEDGE_EXCHANGE",
        "KNOWLEDGE_SAFE_CHECKPOINT",
        "AGENT_CREATE",
        "AGENT_CONTINUE",
        "AGENT_EXECUTE",
        "AGENT_EXCHANGE",
        "AGENT_SAFE_CHECKPOINT"
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "DENIED"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "sid",
        "userScope"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "sid": {
          "type": "string",
          "format": "uuid"
        },
        "userScope": {
          "enum": [
            "blog",
            "admin"
          ]
        }
      }
    },
    "actorService": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledgeBaseId",
        "clientRequestId"
      ],
      "properties": {
        "knowledgeBaseId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "controlEpoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "workerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "stepId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "checkpointOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        }
      }
    },
    "permissionsByAudience": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "description": "For AGENT_SAFE_CHECKPOINT, the Agent authority must derive this deadline from durable facts and never return a time later than the started step save window or current worker lease. It must reject a not-yet-started, revoked or expired step or lease and any run, epoch, worker, step or operation mismatch."
    },
    "authorizationExpiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "parentGrantId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "rootGrantId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
