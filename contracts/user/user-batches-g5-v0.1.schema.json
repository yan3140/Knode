{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G5 user batch API",
  "$defs": {
    "userId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "Must also be <= 9223372036854775807."
    },
    "userIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/userId"
      },
      "description": "Duplicates are accepted; response is deduplicated in first-occurrence order."
    },
    "profilesRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userIds"
      ],
      "properties": {
        "userIds": {
          "$ref": "#/$defs/userIds"
        }
      }
    },
    "validityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userIds",
        "purpose"
      ],
      "properties": {
        "userIds": {
          "$ref": "#/$defs/userIds"
        },
        "purpose": {
          "enum": [
            "FOLLOW_TARGET",
            "DELEGATION_CHECK"
          ],
          "description": "FOLLOW_TARGET also covers both account endpoints of existing follow relationships for Community list, page-total and profile-count reads; see user-validity-v0.1.1.json for consistency and failure boundaries. DELEGATION_CHECK is unchanged."
        }
      }
    },
    "profileFound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "status",
        "nickName",
        "avatar",
        "profileRevision",
        "updatedAt"
      ],
      "properties": {
        "userId": {
          "$ref": "#/$defs/userId"
        },
        "status": {
          "const": "FOUND"
        },
        "nickName": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatar": {
          "type": [
            "string",
            "null"
          ]
        },
        "profileRevision": {
          "$ref": "#/$defs/userId"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "profileMissing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "status"
      ],
      "properties": {
        "userId": {
          "$ref": "#/$defs/userId"
        },
        "status": {
          "const": "MISSING"
        }
      }
    },
    "profilesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/profileFound"
              },
              {
                "$ref": "#/$defs/profileMissing"
              }
            ]
          }
        }
      }
    },
    "validityResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "userId",
              "exists",
              "active"
            ],
            "properties": {
              "userId": {
                "$ref": "#/$defs/userId"
              },
              "exists": {
                "type": "boolean"
              },
              "active": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/profilesRequest"
    },
    {
      "$ref": "#/$defs/validityRequest"
    },
    {
      "$ref": "#/$defs/profilesResponse"
    },
    {
      "$ref": "#/$defs/validityResponse"
    },
    {
      "$ref": "#/$defs/error"
    }
  ]
}
