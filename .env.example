# Local-only configuration. Copy to .env; the application imports it as a properties file.
# Do not commit .env or real keys.

# Agent: WenwenAI Responses API. This key must never be used for embeddings.
OPENAI_API_KEY=
YANBLOG_AGENT_RESPONSES_URL=https://api.wenwenai.org/v1/responses
YANBLOG_AGENT_MODEL=gpt-5.6
YANBLOG_AGENT_REASONING_EFFORT=medium
YANBLOG_AGENT_STREAM=false
YANBLOG_AGENT_STORE=false

# Java <-> Python Agent service identity. Use a long random value outside local development.
YANBLOG_AGENT_INTERNAL_ENABLED=false
YANBLOG_AGENT_SERVICE_KEY=
YANBLOG_AGENT_PRINCIPAL_JWT_SECRET=
YANBLOG_AGENT_PRINCIPAL_JWT_TTL_SECONDS=60

# Python Agent container runtime. Use a registry digest outside local development.
YAN_AGENT_IMAGE=yan-agent:local
YAN_AGENT_JAVA_BASE_URL=http://host.docker.internal:8989
YAN_AGENT_MODEL_RESPONSES_URL=https://api.wenwenai.org/v1/responses
YAN_AGENT_MODEL_NAME=gpt-5.4
YAN_AGENT_MODEL_REASONING_EFFORT=medium
YAN_AGENT_OTEL_TRACE_SAMPLE_RATIO=1.0
YAN_AGENT_LOG_LEVEL=INFO
YAN_AGENT_ADAPTIVE_ROUTING_ENABLED=true
YAN_AGENT_ADAPTIVE_ROUTING_SHADOW_MODE=true
YAN_AGENT_MULTI_QUERY_ENABLED=false
YAN_AGENT_MULTI_QUERY_ROLLOUT_PERCENT=0
YAN_AGENT_ROUTING_ROLLOUT_SALT=adaptive-router.v1

# Embedding: Zhipu OpenAI-compatible API. This key must never be used by the Agent.
ZHIPU_KEY=
YANBLOG_EMBEDDING_PROVIDER=zhipu-openai-compatible
YANBLOG_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
YANBLOG_EMBEDDING_MODEL=embedding-3
YANBLOG_EMBEDDING_DIMENSIONS=1024
