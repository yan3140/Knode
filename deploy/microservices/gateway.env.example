# Local example: enable only against an isolated Nacos instance.
NACOS_DISCOVERY_ENABLED=false
NACOS_CONFIG_ENABLED=false
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=KNODE_SERVICE
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_CONFIG_IMPORT=
# Example import syntax (set explicitly when isolated Nacos is available):
# NACOS_CONFIG_IMPORT=optional:nacos:knode-gateway.yaml?group=KNODE_SERVICE

# Governance requires a separately created isolated Nacos namespace.
KNODE_GOV_NACOS_ENABLED=false
KNODE_GOV_NACOS_SERVER_ADDR=
KNODE_GOV_NACOS_NAMESPACE=
KNODE_GOV_NACOS_GROUP=KNODE_SENTINEL
KNODE_GOV_NACOS_USERNAME=
KNODE_GOV_NACOS_PASSWORD=

# User verification: set a semicolon-separated kid=public-PEM-path list.
KNODE_GATEWAY_AUTH_CONFIGURED=false
KNODE_GATEWAY_AUTH_PUBLIC_KEYS=
KNODE_GATEWAY_AUTH_ENVIRONMENT=
KNODE_GATEWAY_AUTH_REDIS_HOST=
KNODE_GATEWAY_AUTH_REDIS_PORT=
KNODE_GATEWAY_AUTH_REDIS_USERNAME=
KNODE_GATEWAY_AUTH_REDIS_PASSWORD=
KNODE_GATEWAY_AUTH_REDIS_DATABASE=0
KNODE_GATEWAY_AUTH_TIMEOUT_MS=1000

KNODE_GOV_NACOS_RETRY_MIN_MS=1000
KNODE_GOV_NACOS_RETRY_MAX_MS=30000
