# Apply only to a service which explicitly includes knode-governance.
SPRING_APPLICATION_NAME=
KNODE_GOVERNANCE_ENABLED=false
KNODE_GOVERNANCE_NACOS_SERVER_ADDR=
KNODE_GOVERNANCE_NACOS_NAMESPACE=
KNODE_GOVERNANCE_NACOS_GROUP=KNODE_SENTINEL
KNODE_GOVERNANCE_NACOS_USERNAME=
KNODE_GOVERNANCE_NACOS_PASSWORD=
KNODE_GOVERNANCE_NACOS_RETRY_MIN_MS=1000
KNODE_GOVERNANCE_NACOS_RETRY_MAX_MS=30000
# Before JVM startup set -Dproject.name to SPRING_APPLICATION_NAME, then:
# -Dcsp.sentinel.dashboard.server=127.0.0.1:18091 -Dcsp.sentinel.api.port=18720
# -Dcsp.sentinel.heartbeat.client.ip=127.0.0.1
# The official command server listens on all interfaces and is unauthenticated.
# Use an OS firewall or a dedicated isolated network; the IP property is only advertised.
