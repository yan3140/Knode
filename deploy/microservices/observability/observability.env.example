# Opt in per service. Values below are local examples, not credentials.
KNODE_OBSERVABILITY_ENABLED=false
KNODE_ENVIRONMENT=local
KNODE_SERVICE_VERSION=1.0-SNAPSHOT
KNODE_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
KNODE_TRACE_SAMPLE_RATIO=0.1
# Keep management on loopback; configure a distinct port before exposing prometheus.
# MANAGEMENT_SERVER_ADDRESS=127.0.0.1
# MANAGEMENT_SERVER_PORT=19089
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus
KNODE_OTLP_GRPC_BIND=127.0.0.1:4317
KNODE_OTLP_HTTP_BIND=127.0.0.1:4318
KNODE_COLLECTOR_HEALTH_BIND=127.0.0.1:13133
KNODE_JAEGER_OTLP_ENDPOINT=http://127.0.0.1:14318
KNODE_COLLECTOR_METRICS_PORT=18888

# Optional Python tracing fixture / Agent process settings: queue counts, delay in ms.
OTEL_BSP_MAX_QUEUE_SIZE=512
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=128
OTEL_BSP_SCHEDULE_DELAY=1000
# The Python OTLP HTTP exporter uses seconds for this timeout.
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=2
