# Use an immutable registry digest in production.
YAN_AGENT_IMAGE=registry.example.com/yan-agent@sha256:replace-me

# Required secrets. Inject these from a secret manager; do not commit real values.
OPENAI_API_KEY=
YANBLOG_AGENT_SERVICE_KEY=
YANBLOG_AGENT_PRINCIPAL_JWT_SECRET=

# Runtime tuning.
YAN_AGENT_JAVA_BASE_URL=http://host.docker.internal:8989
YAN_AGENT_MODEL_RESPONSES_URL=https://api.wenwenai.org/v1/responses
YAN_AGENT_MODEL_NAME=gpt-5.6
YAN_AGENT_MODEL_REASONING_EFFORT=medium
YAN_AGENT_ANALYZER_REASONING_EFFORT=none
YAN_AGENT_ANALYZER_TIMEOUT_SECONDS=8
YAN_AGENT_ANALYZER_MAX_OUTPUT_TOKENS=1000
YAN_AGENT_ANALYZER_MAX_ATTEMPTS=1
YAN_AGENT_MODEL_INPUT_COST_PER_MILLION=0
YAN_AGENT_MODEL_OUTPUT_COST_PER_MILLION=0
YAN_AGENT_OTEL_TRACE_SAMPLE_RATIO=0.2
YAN_AGENT_LOG_LEVEL=INFO

# Stage 5.5-F starts in audit-only shadow mode. Keep C disabled until its
# retrieval gates have a non-empty passing sample.
YAN_AGENT_ADAPTIVE_ROUTING_ENABLED=true
YAN_AGENT_ADAPTIVE_ROUTING_SHADOW_MODE=true
YAN_AGENT_ADAPTIVE_EXECUTION_ENABLED=false
YAN_AGENT_RAW_QUERY_ENABLED=false
YAN_AGENT_RAW_QUERY_ROLLOUT_PERCENT=0
YAN_AGENT_MULTI_QUERY_ENABLED=false
YAN_AGENT_MULTI_QUERY_ROLLOUT_PERCENT=0
YAN_AGENT_MULTI_QUERY_QUALITY_GATE_PASSED=false
YAN_AGENT_ROUTING_ROLLOUT_SALT=adaptive-router.v1

# Optional host bindings and operations endpoints when default ports are occupied.
YAN_AGENT_PROMETHEUS_BIND=127.0.0.1:19090
YAN_AGENT_OPS_PROMETHEUS_URL=http://127.0.0.1:19090
