# Replace all placeholder values with deployment-provided secrets. Use only a new isolated user database.
KNODE_USER_DB_URL=jdbc:mysql://isolated-db:13306/knode_user?serverTimezone=Asia%2FShanghai
KNODE_USER_DB_USERNAME=replace_user_database_account
KNODE_USER_DB_PASSWORD=replace_using_secret_manager
KNODE_AUTH_ENVIRONMENT=local
KNODE_AUTH_SIGNING_KID=replace_key_id
KNODE_AUTH_SIGNING_PRIVATE_FILE=/secure/path/user-private-pkcs8.pem
KNODE_AUTH_SIGNING_PUBLIC_FILE=/secure/path/user-public-x509.pem
# Alternative to PRIVATE_FILE: set KNODE_AUTH_SIGNING_PRIVATE_ENV to the name of an environment variable containing PEM.
KNODE_AUTH_REDIS_READ_HOST=isolated-redis
KNODE_AUTH_REDIS_READ_PORT=16379
KNODE_AUTH_REDIS_READ_USERNAME=replace_read_only_identity
KNODE_AUTH_REDIS_READ_PASSWORD=replace_using_secret_manager
KNODE_AUTH_REDIS_READ_DATABASE=0
KNODE_AUTH_REDIS_READ_TLS=true
KNODE_AUTH_REDIS_WRITE_HOST=isolated-redis
KNODE_AUTH_REDIS_WRITE_PORT=16379
KNODE_AUTH_REDIS_WRITE_USERNAME=replace_user_write_identity
KNODE_AUTH_REDIS_WRITE_PASSWORD=replace_using_secret_manager
KNODE_AUTH_REDIS_WRITE_DATABASE=0
KNODE_AUTH_REDIS_WRITE_TLS=true

KNODE_AUTH_REVOCATION_POLL_MS=5000
KNODE_AUTH_REVOCATION_INITIAL_MS=5000
